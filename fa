
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local MiningEngine = {
    IsRunning = false,
    Delay = 0.5,
    MaxDistance = 50,
    TargetName = "Ore",
    OnStatusChanged = nil
}

function MiningEngine:_notify(status)
    if self.OnStatusChanged then
        self.OnStatusChanged(status)
    end
end

function MiningEngine:_getClosestTarget()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end

    local originPos = character.HumanoidRootPart.Position
    local closestTarget = nil
    local shortestDistance = self.MaxDistance

    local container = Workspace:FindFirstChild("MiningNodes") or Workspace
    for _, node in ipairs(container:GetChildren()) do
        if node.Name == self.TargetName then
            local primaryPart = node.PrimaryPart or node:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                local distance = (originPos - primaryPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestTarget = node
                end
            end
        end
    end

    return closestTarget
end

function MiningEngine:_executeAction(target)
    if not target then return end

    local prompt = target:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end
        return
    end

    local remote = target:FindFirstChild("MineEvent") or target:FindFirstChildWhichIsA("RemoteEvent", true)
    if remote then
        remote:FireServer()
    end
end

function MiningEngine:Start()
    if self.IsRunning then return end
    self.IsRunning = true

    task.spawn(function()
        while self.IsRunning do
            local target = self:_getClosestTarget()
            if target then
                self:_notify("Mining: " .. target.Name)
                self:_executeAction(target)
                task.wait(self.Delay)
            else
                self:_notify("Mencari Target...")
                task.wait(1.5)
            end
        end
        self:_notify("Status: Nonaktif")
    end)
end

function MiningEngine:Stop()
    self.IsRunning = false
end

function MiningEngine:Toggle()
    if self.IsRunning then
        self:Stop()
    else
        self:Start()
    end
end

local MiningGUI = {}

function MiningGUI.Create()
    if CoreGui:FindFirstChild("AutoMiningGui") then
        CoreGui.AutoMiningGui:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "AutoMiningGui"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui

    local MainFrame = Instance.new("Frame")
